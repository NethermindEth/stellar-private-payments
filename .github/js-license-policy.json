    "AGPL-3.0-or-later",
    "CC-BY-SA",
    "CC-BY-SA-4.0",
    "UNKNOWN",
    "UNLICENSED"
  ],
  "exceptions": [
    {
      "package": "stellar-private-payments",
      "version": "*",
      "license": "UNKNOWN",
      "target": "app/package-lock.json",
      "justification": "Local workspace package loaded via file: link. The link lockfile entry has no license field; sdk/web/package.json declares Apache-2.0 and the published tarball ships dist/LICENSE.txt.",
