    "CC-BY-3.0",
    "CC-BY-4.0",
    "CC0-1.0",
    "CDLA-Permissive-1.0",
    "CDLA-Permissive-2.0",
    "FTL",
    "ISC",
    "JSON",
    "MIT",
    "MS-PL",
    "OpenSSL",
    "PostgreSQL",
    "SHL-0.5",
    "SHL-0.51",
    "TCP-wrappers",
    "UPL-1.0",
    "Unicode-3.0",
    "Unicode-DFS-2016",
    "W3C-20150513",
    "WTFPL",
    "Xnet",
