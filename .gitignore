# IDEs
.vscode
.idea

# macOS
.DS_Store

# Rust/Cargo
debug/
target/

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# These are backup files generated by rustfmt
**/*.rs.bk

lcov.info

# Circom
circuits/compiled
circuits/src/circomlib/
circuits/**/*.r1cs
circuits/**/*.sym
circuits/**/*.wasm
circuits/**/*.cpp
circuits/**/*.hpp
circuits/**/*.asm
circuits/**/witness_calculator.js
circuits/**/generate_witness.js
circuits/**/*.dat
circuits/**/Makefile

# Contracts
contracts/**/test_snapshots

# Tests artefacts
e2e-tests/test_snapshots/*

# App
app/node_modules
/dist/

# Playwright E2E
app/e2e/.freighter-extension/
app/e2e/test-results/
app/e2e/playwright-report/

# Testdata
testdata/*

# mdBook
docs/book/

# Ceremony
ceremony/
*.ptau
artifacts.zip
circuits/graph*.bin

# Build profile markers
sdk/web/.trunk-wasm-profile

# JS license tooling
js-license-scan-report.json

# SDK example wallets. The examples default SPP_WALLET_PATH to
# ./spp-example-wallet.sqlite, and `spp onboard --data-dir ./spp-<name>-wallet`
# writes spp.db there, so a first run would otherwise dirty the working tree.
spp-example-wallet.sqlite
spp-example-wallet.sqlite-*
spp-*-wallet/

# E2E test account material written by deployments/scripts/e2e-accounts-setup.sh.
# Contains testnet secret keys — must never be committed.
deployments/*/.e2e-accounts.env
deployments/scripts/.e2e-wallet-*/
